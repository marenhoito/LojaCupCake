@model IReadOnlyList<LojaCupCake.ViewModels.ChatConversaViewModel>
@using System.Globalization
@{
    ViewData["Title"] = "Mensagens";
    bool ehCliente = ViewData["EhCliente"] as bool? ?? false;
    var cultura = CultureInfo.GetCultureInfo("pt-BR");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h2 class="mb-1">Mensagens</h2>
            <p class="text-muted mb-0">Conversas vinculadas aos pedidos.</p>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Você ainda não possui conversas. As conversas aparecem aqui quando uma mensagem é enviada em um pedido.
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var conversa in Model)
            {
                <a asp-controller="Chat"
                   asp-action="Pedido"
                   asp-route-id="@conversa.PedidoId"
                   class="list-group-item list-group-item-action @(conversa.MensagensNaoLidas > 0 ? "list-group-item-primary" : "")">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1 text-truncate">
                            <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                                <strong>Pedido @conversa.CodigoPedido</strong>
                                @if (conversa.MensagensNaoLidas > 0)
                                {
                                    <span class="badge rounded-pill bg-danger">
                                        @conversa.MensagensNaoLidas @(conversa.MensagensNaoLidas == 1 ? "não lida" : "não lidas")
                                    </span>
                                }
                            </div>
                            <div class="small text-muted mb-1">
                                @(ehCliente ? conversa.NomeFilial : conversa.NomeCliente)
                            </div>
                            <div class="text-truncate">@conversa.UltimaMensagem</div>
                        </div>
                        <small class="text-muted text-nowrap">
                            @(conversa.DataUltimaMensagem?.ToLocalTime().ToString("dd/MM HH:mm", cultura) ?? "")
                        </small>
                    </div>
                </a>
            }
        </div>
    }
</div>
