@section Scripts {
    <script>
        document.querySelectorAll('[data-quantity-control]').forEach(function (control) {
            const input = control.querySelector('input[name="quantidade"]');
            control.querySelectorAll('[data-quantity-step]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const step = Number(button.dataset.quantityStep || 0);
                    const min = Number(input.min || 1);
                    const max = Number(input.max || 999);
                    const current = Number(input.value || min);
                    input.value = Math.min(max, Math.max(min, current + step));
                });
            });
        });
    </script>
}
