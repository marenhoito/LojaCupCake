@model LojaCupCake.ViewModels.DashboardAdminViewModel

@{
    ViewData["Title"] = "Dashboard administrativo";
    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Dashboard administrativo</h2>
        <p class="text-muted">
            Visão geral do desempenho da LojaCupCake.
        </p>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <!-- FILTROS -->
    <div class="card mb-4">
        <div class="card-header">Filtros do relatório</div>

        <div class="card-body">
            <form asp-action="Index" method="get">
                <!-- Diferencia a primeira abertura (todas selecionadas)
                     de um filtro enviado sem nenhuma filial marcada. -->
                <input type="hidden" name="filiaisSelecionadas" value="true" />

                <div class="mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
                        <label class="form-label fw-semibold mb-0">Filiais consideradas</label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="selecionarTodasFiliais">
                                Selecionar todas
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="limparFiliais">
                                Limpar seleção
                            </button>
                        </div>
                    </div>

                    @if (!Model.Filiais.Any())
                    {
                        <div class="alert alert-warning mb-0">
                            Nenhuma filial cadastrada.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2" id="listaFiliais">
                            @foreach (var filial in Model.Filiais)
                            {
                                <div class="col-sm-6 col-lg-4">
                                    <label class="border rounded p-2 d-flex align-items-center gap-2 h-100 w-100">
                                        <input class="form-check-input mt-0"
                                               type="checkbox"
                                               name="filialIds"
                                               value="@filial.Value"
                                               checked="@(filial.Selected ? "checked" : null)" />
                                        <span>@filial.Text</span>
                                    </label>
                                </div>
                            }
                        </div>
                    }
                    <small class="text-muted d-block mt-2">
                        As filiais desativadas aparecem aqui para consulta administrativa e estão identificadas no nome.
                    </small>
                </div>

                <div class="row align-items-end">
                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="dataInicial">Data inicial</label>
                        <input type="date"
                               id="dataInicial"
                               name="dataInicial"
                               value="@Model.DataInicial.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label" for="dataFinal">Data final</label>
                        <input type="date"
                               id="dataFinal"
                               name="dataFinal"
                               value="@Model.DataFinal.ToString("yyyy-MM-dd")"
                               class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <button type="submit" class="btn btn-primary w-100">
                            Filtrar
                        </button>
                    </div>
                </div>
            </form>

            <small class="text-muted">
                Período considerado no horário de Brasília. Máximo de 366 dias.
            </small>
        </div>
    </div>

    <!-- EXPORTAÇÃO DOS RELATÓRIOS -->
    <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">
        <form asp-controller="Relatorios" asp-action="Excel" method="get">
            <input type="hidden" name="dataInicial" value="@Model.DataInicial.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dataFinal" value="@Model.DataFinal.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="filiaisSelecionadas" value="true" />
            @foreach (var filialIdSelecionada in Model.FilialIds)
            {
                <input type="hidden" name="filialIds" value="@filialIdSelecionada" />
            }
            <button type="submit" class="btn btn-outline-success">
                Exportar Excel
            </button>
        </form>

        <form asp-controller="Relatorios" asp-action="Pdf" method="get">
            <input type="hidden" name="dataInicial" value="@Model.DataInicial.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dataFinal" value="@Model.DataFinal.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="filiaisSelecionadas" value="true" />
            @foreach (var filialIdSelecionada in Model.FilialIds)
            {
                <input type="hidden" name="filialIds" value="@filialIdSelecionada" />
            }
            <button type="submit" class="btn btn-outline-danger">
                Exportar PDF
            </button>
        </form>
    </div>

    <!-- INDICADORES -->
    <div class="row mb-4">
        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Pedidos no período</p>
                    <h2>@Model.TotalPedidos</h2>
                    <small class="text-muted">Todos os status</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Aguardando aprovação</p>
                    <h2 class="text-warning">@Model.PedidosPendentes</h2>
                    <small class="text-muted">Pedidos pendentes</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Pedidos concluídos</p>
                    <h2 class="text-success">@Model.PedidosConcluidos</h2>
                    <small class="text-muted">Pagamentos aprovados</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Faturamento</p>
                    <h2 class="text-primary">@Model.Faturamento.ToString("C", cultura)</h2>
                    <small class="text-muted">Pedidos concluídos e pagos</small>
                </div>
            </div>
        </div>
    </div>

    <!-- TICKET E ESTOQUE -->
    <div class="row mb-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Ticket médio</p>
                    <h3>@Model.TicketMedio.ToString("C", cultura)</h3>
                    <small class="text-muted">Faturamento dividido pelos pedidos concluídos e pagos.</small>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Produtos com estoque baixo</p>
                    <h3 class="@(Model.ProdutosEstoqueBaixo > 0 ? "text-danger" : "text-success")">
                        @Model.ProdutosEstoqueBaixo
                    </h3>
                    <small class="text-muted">Estoques iguais ou abaixo do mínimo configurado.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- VENDAS POR DIA -->
    <div class="card mb-4">
        <div class="card-header">Vendas por dia</div>
        <div class="card-body">
            @if (!Model.VendasPorDia.Any())
            {
                <div class="alert alert-info mb-0">Nenhuma venda concluída e paga neste período para as filiais selecionadas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>Data</th><th>Pedidos</th><th>Total vendido</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var venda in Model.VendasPorDia)
                            {
                                <tr>
                                    <td>@venda.Data.ToString("dd/MM/yyyy")</td>
                                    <td>@venda.QuantidadePedidos</td>
                                    <td><strong>@venda.TotalVendido.ToString("C", cultura)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- PRODUTOS MAIS VENDIDOS -->
    <div class="card mb-4">
        <div class="card-header">Produtos mais vendidos</div>
        <div class="card-body">
            @if (!Model.ProdutosMaisVendidos.Any())
            {
                <div class="alert alert-info mb-0">Não existem vendas concluídas neste período para as filiais selecionadas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr><th>Produto</th><th>Quantidade vendida</th><th>Total vendido</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var produto in Model.ProdutosMaisVendidos)
                            {
                                <tr>
                                    <td>@produto.NomeProduto</td>
                                    <td>@produto.QuantidadeVendida</td>
                                    <td>@produto.TotalVendido.ToString("C", cultura)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ALERTAS DE ESTOQUE -->
    <div class="card mb-4">
        <div class="card-header">Alertas de estoque</div>
        <div class="card-body">
            @if (!Model.EstoquesBaixos.Any())
            {
                <div class="alert alert-success mb-0">Nenhum produto abaixo do estoque mínimo nas filiais selecionadas.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>Filial</th>
                                <th>Status da filial</th>
                                <th>Produto</th>
                                <th>Quantidade atual</th>
                                <th>Quantidade mínima</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var estoque in Model.EstoquesBaixos)
                            {
                                <tr>
                                    <td>@estoque.NomeFilial</td>
                                    <td>
                                        @if (estoque.FilialAtiva)
                                        {
                                            <span class="badge bg-success">Ativa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Desativada</span>
                                        }
                                    </td>
                                    <td>@estoque.NomeProduto</td>
                                    <td><strong class="text-danger">@estoque.QuantidadeAtual</strong></td>
                                    <td>@estoque.QuantidadeMinima</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.ProdutosEstoqueBaixo > Model.EstoquesBaixos.Count)
                {
                    <small class="text-muted">
                        Exibindo os primeiros 20 registros. Total de alertas: @Model.ProdutosEstoqueBaixo.
                    </small>
                }
            }
        </div>
    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const caixas = () => document.querySelectorAll('input[name="filialIds"]');

            document.getElementById("selecionarTodasFiliais")?.addEventListener("click", function () {
                caixas().forEach(caixa => caixa.checked = true);
            });

            document.getElementById("limparFiliais")?.addEventListener("click", function () {
                caixas().forEach(caixa => caixa.checked = false);
            });
        });
    </script>
}