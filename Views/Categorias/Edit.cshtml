@model LojaCupCake.ViewModels.CategoriaViewModel

@{
    ViewData["Title"] = "Editar categoria";
}

<div class="container mt-4">

    <h2 class="mb-4">Editar categoria</h2>

    <div class="card">
        <div class="card-header">
            Informações da categoria
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="CategoriaId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nome"
                           class="form-label"></label>

                    <input asp-for="Nome"
                           class="form-control" />

                    <span asp-validation-for="Nome"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao"
                           class="form-label"></label>

                    <textarea asp-for="Descricao"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="Descricao"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Situação atual
                    </label>

                    <div>
                        @if (Model.Ativa)
                        {
                            <span class="badge bg-success">
                                Ativa
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inativa
                            </span>
                        }
                    </div>

                    <small class="text-muted">
                        Para alterar a situação, utilize o botão
                        correspondente na listagem de categorias.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Salvar alterações
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Voltar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
