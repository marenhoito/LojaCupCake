@model IEnumerable<LojaCupCake.ViewModels.CategoriaViewModel>

@{
    ViewData["Title"] = "Categorias";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Categorias</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nova categoria
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhuma categoria cadastrada.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Categoria</th>
                        <th>Descrição</th>
                        <th>Produtos</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var categoria in Model)
                    {
                        <tr>
                            <td>
                                <strong>@categoria.Nome</strong>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(categoria.Descricao)
                                                        ? "Sem descrição"
                                                        : categoria.Descricao)
                    </td>

                            <td>
                                @categoria.QuantidadeProdutos
                            </td>

                            <td>
                        @if (categoria.Ativa)
                                {
                                    <span class="badge bg-success">
                                        Ativa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativa
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@categoria.CategoriaId"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <form asp-action="AlterarStatus"
                                          asp-route-id="@categoria.CategoriaId"
                                          method="post"
                                          onsubmit="return confirm('Deseja alterar a situação desta categoria?');">

                                        <button type="submit"
                                                class="btn btn-sm @(categoria.Ativa ? "btn-outline-danger" : "btn-outline-success")">

                                            @(categoria.Ativa ? "Desativar" : "Ativar")

                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
