@model LojaCupCake.ViewModels.EstoqueMinimoViewModel

@{
    ViewData["Title"] = "Configurar estoque mínimo";
}

<div class="container mt-4">

    <h2 class="mb-4">Configurar estoque mínimo</h2>

    <div class="card">
        <div class="card-header">
            Informações do estoque
        </div>

        <div class="card-body">

            <p>
                <strong>Filial:</strong> @Model.NomeFilial
            </p>

            <p>
                <strong>Produto:</strong> @Model.NomeProduto
            </p>

            <p>
                <strong>Quantidade atual:</strong>
                @Model.QuantidadeAtual
            </p>

            <hr />

            <form asp-action="ConfigurarMinimo" method="post">

                <input type="hidden" asp-for="FilialId" />
                <input type="hidden" asp-for="ProdutoId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="QuantidadeMinima"
                           class="form-label"></label>

                    <input asp-for="QuantidadeMinima"
                           type="number"
                           min="0"
                           step="1"
                           class="form-control" />

                    <span asp-validation-for="QuantidadeMinima"
                          class="text-danger"></span>

                    <small class="text-muted">
                        Quando o estoque atingir ou ficar abaixo
                        desta quantidade, será exibido um alerta.
                    </small>
                </div>

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-primary">
                        Salvar configuração
                    </button>

                    <a asp-action="Index"
                       asp-route-filialId="@Model.FilialId"
                       class="btn btn-secondary">
                        Voltar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
