@model LojaCupCake.ViewModels.EstoqueIndexViewModel

@{
    ViewData["Title"] = "Controle de estoque";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Controle de estoque</h2>
        <p class="text-muted">
            Consulte a disponibilidade de produtos por filial.
        </p>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }


    <div class="card mb-4">
        <div class="card-header">
            Selecionar filial
        </div>

        <div class="card-body">

            @if (!Model.Filiais.Any())
            {
                <div class="alert alert-warning mb-0">
                    Nenhuma filial disponível para consulta.
                </div>
            }
            else
            {
                <form asp-action="Index" method="get">

                    <div class="row align-items-end">

                        <div class="col-md-8 mb-3">
                            <label asp-for="FilialId"
                                   class="form-label">
                                Filial
                            </label>

                            <select asp-for="FilialId"
                                    asp-items="Model.Filiais"
                                    class="form-select">
                                <option value="">
                                    Selecione uma filial
                                </option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-3">
                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Consultar estoque
                            </button>
                        </div>

                    </div>

                </form>
            }

        </div>
    </div>

    @if (Model.FilialId.HasValue)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4>@Model.NomeFilial</h4>

            <span class="badge bg-primary">
                @Model.Produtos.Count produtos
            </span>
        </div>

        @if (!Model.Produtos.Any())
        {
            <div class="alert alert-info">
                Não existem produtos ativos cadastrados.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Quantidade atual</th>
                            <th>Quantidade mínima</th>
                            <th>Situação</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var produto in Model.Produtos)
                        {
                            <tr>
                                <td>@produto.Codigo</td>

                                <td>
                                    <strong>@produto.NomeProduto</strong>
                                </td>

                                <td>@produto.NomeCategoria</td>

                                <td>
                                    <strong>@produto.QuantidadeAtual</strong>
                                </td>

                                <td>@produto.QuantidadeMinima</td>

                                <td>
                                    @if (!produto.PossuiEstoqueCadastrado)
                                    {
                                        <span class="badge bg-secondary">
                                            Sem cadastro
                                        </span>
                                    }
                                    else if (produto.QuantidadeAtual == 0)
                                    {
                                        <span class="badge bg-danger">
                                            Sem estoque
                                        </span>
                                    }
                                    else if (produto.QuantidadeAtual <= produto.QuantidadeMinima)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Estoque baixo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Disponível
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">

                                        <a asp-action="Historico"
                                           asp-route-filialId="@Model.FilialId"
                                           asp-route-produtoId="@produto.ProdutoId"
                                           class="btn btn-sm btn-outline-secondary">
                                            Histórico
                                        </a>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Movimentar"
                                               asp-route-filialId="@Model.FilialId"
                                               asp-route-produtoId="@produto.ProdutoId"
                                               class="btn btn-sm btn-outline-primary">
                                                Movimentar
                                            </a>

                                            <a asp-action="ConfigurarMinimo"
                                               asp-route-filialId="@Model.FilialId"
                                               asp-route-produtoId="@produto.ProdutoId"
                                               class="btn btn-sm btn-outline-dark">
                                                Estoque mínimo
                                            </a>
                                        }

                                    </div>
                                </td>



                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
    }

</div>
