@model IEnumerable<LojaCupCake.ViewModels.ProdutoViewModel>

@{
    ViewData["Title"] = "Produtos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Produtos</h2>

        <a asp-action="Create" class="btn btn-primary">
            Novo produto
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nenhum produto cadastrado.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <thead>
                    <tr>
                        <th>Imagem</th>
                        <th>Código</th>
                        <th>Produto</th>
                        <th>Categoria</th>
                        <th>Preço</th>
                        <th>Situação</th>
                        <th>Ações</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var produto in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(produto.ImagemUrl))
                                {
                                    <img src="@produto.ImagemUrl"
                                         alt="@produto.Nome"
                                         style="width: 65px; height: 65px; object-fit: cover;"
                                         class="rounded" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                         style="width: 65px; height: 65px;">
                                        <span class="text-muted small">
                                            Sem imagem
                                        </span>
                                    </div>
                                }
                            </td>

                            <td>@produto.Codigo</td>

                            <td>
                                <strong>@produto.Nome</strong>
                            </td>

                            <td>@produto.NomeCategoria</td>

                            <td>
                                @produto.PrecoAtual.ToString(
                                "C",
                                   System.Globalization.CultureInfo.GetCultureInfo("pt-BR")
                                )
                            </td>

                            <td>
                                @if (produto.Ativo)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-action="Edit"
                                       asp-route-id="@produto.ProdutoId"
                                       class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <form asp-action="AlterarStatus"
                                          asp-route-id="@produto.ProdutoId"
                                          method="post"
                                          onsubmit="return confirm('Deseja alterar a situação deste produto?');">

                                        <button type="submit"
                                                class="btn btn-sm @(produto.Ativo ? "btn-outline-danger" : "btn-outline-success")">

                                            @(produto.Ativo ? "Desativar" : "Ativar")

                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
