@model LojaCupCake.ViewModels.ProdutoViewModel

@{
    ViewData["Title"] = "Editar produto";
}

<div class="container mt-4 mb-5 produto-form-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <span class="text-uppercase small fw-semibold text-muted">Catálogo</span>
            <h2 class="mb-1">Editar cupcake</h2>
            <p class="text-muted mb-0">Atualize os dados, substitua a foto ou remova a imagem atual.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar aos produtos</a>
    </div>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="ProdutoId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Informações do produto</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                        <option value="">Selecione uma categoria</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control" />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>
                    <div class="col-md-8 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecoAtual" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">R$</span>
                        <input asp-for="PrecoAtual" type="number" min="0.01" step="0.01" class="form-control" />
                    </div>
                    <span asp-validation-for="PrecoAtual" class="text-danger"></span>
                </div>

                <div class="form-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label asp-for="Ativo" class="form-check-label">Produto ativo</label>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Foto do cupcake</div>
            <div class="card-body">
                <div class="row g-4 align-items-start">
                    <div class="col-md-5">
                        <div class="produto-image-preview">
                            @if (!string.IsNullOrWhiteSpace(Model.ImagemUrl))
                            {
                                <img id="previewImagem" src="@Model.ImagemUrl" alt="@Model.Nome" />
                                <div id="previewVazio" class="produto-image-placeholder" hidden>
                                    <span class="produto-image-icon">🧁</span>
                                    <strong>Sem imagem selecionada</strong>
                                </div>
                            }
                            else
                            {
                                <img id="previewImagem" alt="Pré-visualização da imagem do cupcake" hidden />
                                <div id="previewVazio" class="produto-image-placeholder">
                                    <span class="produto-image-icon">🧁</span>
                                    <strong>Este produto ainda não tem foto</strong>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-7">
                        @if (!string.IsNullOrWhiteSpace(Model.ImagemUrl))
                        {
                            <div class="form-check mb-3">
                                <input asp-for="RemoverImagem" class="form-check-input" />
                                <label asp-for="RemoverImagem" class="form-check-label">
                                    Remover imagem atual ao salvar
                                </label>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="ArquivoImagem" class="form-label"></label>
                            <input asp-for="ArquivoImagem" type="file" class="form-control"
                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                   id="arquivoImagem" />
                            <span asp-validation-for="ArquivoImagem" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Formatos aceitos: JPG, PNG ou WEBP. Tamanho máximo: 5 MB.
                                Uma nova foto substitui a imagem atual.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImagemUrl" class="form-alabel"></label>
                            <input asp-for="ImagemUrl" class="form-control"
                                   placeholder="https://exemplo.com/imagem.jpg" />
                            <span asp-validation-for="ImagemUrl" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Você também pode manter ou informar uma URL pública. O envio de arquivo tem prioridade.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salvar alterações</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

<style>
    .produto-image-preview {
        min-height: 260px;
        border: 1px dashed #e5b7c6;
        border-radius: 16px;
        background: #fff8f5;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .produto-image-preview img {
        display: block;
        width: 100%;
        max-height: 320px;
        object-fit: contain;
        background: #fff;
    }

    .produto-image-placeholder {
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: #805b69;
        text-align: center;
    }

    .produto-image-icon { font-size: 3rem; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById("arquivoImagem");
            const preview = document.getElementById("previewImagem");
            const vazio = document.getElementById("previewVazio");
            const remover = document.getElementById("RemoverImagem");
            let urlAnterior = null;

            input?.addEventListener("change", () => {
                const arquivo = input.files && input.files[0];

                if (urlAnterior) {
                    URL.revokeObjectURL(urlAnterior);
                    urlAnterior = null;
                }

                if (!arquivo) {
                    if (preview.getAttribute("src")) {
                        preview.hidden = false;
                        vazio.hidden = true;
                    } else {
                        preview.hidden = true;
                        vazio.hidden = false;
                    }
                    return;
                }

                urlAnterior = URL.createObjectURL(arquivo);
                preview.src = urlAnterior;
                preview.hidden = false;
                vazio.hidden = true;

                if (remover) remover.checked = false;
            });
        })();
    </script>
}
