@model LojaCupCake.Models.Pedido
<partial name="_LinkChatPedido" model="Model" />

@{
    ViewData["Title"] = "Processar pedido";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    var pagamento = Model.Pagamentos
        .OrderByDescending(p => p.CriadoEm)
        .FirstOrDefault();
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Pedido @Model.CodigoPedido</h2>

        <span class="badge bg-primary">
            @Model.StatusPedido
        </span>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">Informações gerais</div>

        <div class="card-body">
            <p><strong>Cliente:</strong> @Model.Cliente.NomeCompleto</p>
            <p><strong>Filial:</strong> @Model.Filial.Nome</p>
            <p>
                <strong>Data:</strong>
                @(Model.DataPedido.ToLocalTime()
                                .ToString("dd/MM/yyyy HH:mm"))
            </p>
            <p><strong>Recebimento:</strong> @Model.TipoRecebimento</p>

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Itens do pedido</div>

        <div class="card-body">

            @foreach (var item in Model.Itens)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>
                        @item.Quantidade x @item.NomeProdutoSnapshot
                    </span>

                    <strong>
                        @item.TotalItem.ToString("C", cultura)
                    </strong>
                </div>
            }

            <hr />

            <div class="d-flex justify-content-between">
                <span>Subtotal</span>
                <strong>@Model.Subtotal.ToString("C", cultura)</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span>Taxa de entrega</span>
                <strong>@Model.TaxaEntrega.ToString("C", cultura)</strong>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <h5>Total</h5>
                <h5 class="text-primary">
                    @Model.Total.ToString("C", cultura)
                </h5>
            </div>

        </div>
    </div>

    @if (Model.EnderecoEntrega != null)
    {
        <div class="card mb-4">
            <div class="card-header">Endereço de entrega</div>

            <div class="card-body">
                <p>
                    @Model.EnderecoEntrega.Destinatario
                </p>

                <p>
                    @Model.EnderecoEntrega.Logradouro,
                    @Model.EnderecoEntrega.Numero
                </p>

                <p>
                    @Model.EnderecoEntrega.Bairro -
                    @Model.EnderecoEntrega.Cidade /
                    @Model.EnderecoEntrega.Uf
                </p>

                <p>CEP: @Model.EnderecoEntrega.Cep</p>

                <p>
                    Telefone:
                    @Model.EnderecoEntrega.TelefoneContato
                </p>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">Pagamento</div>

        <div class="card-body">

            @if (pagamento != null)
            {
                <p><strong>Forma:</strong> @pagamento.FormaPagamento</p>

                <p><strong>Status:</strong> @pagamento.StatusPagamento</p>

                <p>
                    <strong>Valor:</strong>
                    @pagamento.Valor.ToString("C", cultura)
                </p>

                @if (!string.IsNullOrWhiteSpace(pagamento.CodigoTransacao))
                {
                    <p>
                        <strong>Referência:</strong>
                        @pagamento.CodigoTransacao
                    </p>
                }
            }

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Atualizar andamento</div>

        <div class="card-body">

            <partial name="_ConfirmacoesRecebimento" model="Model" />

            @if (Model.StatusPedido ==
                        LojaCupCake.Models.StatusPedido.AguardandoAprovacao)
            {
                <div class="alert alert-info">
                    Verifique o pagamento e a disponibilidade antes de aprovar.
                </div>
            }

            @if (Model.StatusPedido ==
                        LojaCupCake.Models.StatusPedido.Rejeitado)
            {
                <div class="alert alert-danger">
                    Pedido rejeitado. As unidades reservadas foram devolvidas ao estoque.
                </div>
            }
            else if (Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.Concluido)
            {
                <div class="alert alert-success">
                    Pedido concluído.
                </div>
            }
            else if (Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.AguardandoAprovacao ||
            Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.Aprovado ||
            Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.EmPreparacao ||
            Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.Pronto ||
            Model.StatusPedido ==
            LojaCupCake.Models.StatusPedido.SaiuParaEntrega)
            {
                <form asp-action="AlterarStatus" method="post">

                    <input type="hidden"
                           name="pedidoId"
                           value="@Model.PedidoId" />

                    <div class="mb-3">
                        <label class="form-label">
                            Próximo status
                        </label>

                        <select name="novoStatus"
                                class="form-select"
                                required>

                            @if (Model.StatusPedido ==
                                                    LojaCupCake.Models.StatusPedido.AguardandoAprovacao)
                            {
                                <option value="Aprovado">
                                    Aprovar pedido
                                </option>

                                <option value="Rejeitado">
                                    Rejeitar pedido
                                </option>
                            }
                            else if (Model.StatusPedido ==
                            LojaCupCake.Models.StatusPedido.Aprovado)
                            {
                                <option value="EmPreparacao">
                                    Iniciar preparação
                                </option>
                            }
                            else if (Model.StatusPedido ==
                            LojaCupCake.Models.StatusPedido.EmPreparacao)
                            {
                                <option value="Pronto">
                                    Marcar como pronto
                                </option>
                            }
                            else if (Model.StatusPedido ==
                            LojaCupCake.Models.StatusPedido.Pronto)
                            {
                                @if (Model.TipoRecebimento ==
                                                        LojaCupCake.Models.TipoRecebimento.Entrega)
                                {
                                    <option value="SaiuParaEntrega">
                                        Saiu para entrega
                                    </option>
                                }
                                else
                                {
                                    <option value="Concluido">
                                        Concluir retirada
                                    </option>
                                }
                            }
                            else if (Model.StatusPedido ==
                            LojaCupCake.Models.StatusPedido.SaiuParaEntrega)
                            {
                                <option value="Concluido">
                                    Concluir entrega
                                </option>
                            }

                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Observação
                        </label>

                        <textarea name="observacao"
                              class="form-control"
                              rows="3"
                              maxlength="500"></textarea>
                    </div>

                    <button type="submit"
                            class="btn btn-primary">
                        Atualizar pedido
                    </button>

                </form>
            }

        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Histórico de status</div>

        <div class="card-body">

            @foreach (var historico in Model.Historico.OrderBy(h => h.DataAlteracao))
            {
                <div class="border-bottom py-2">

                    <strong>@historico.StatusNovo</strong>

                    <br />

                    <small class="text-muted">
                        @(historico.DataAlteracao.ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))
                    — @(historico.Responsavel?.Email ?? "Sistema")
                </small>

                @if (!string.IsNullOrWhiteSpace(historico.Observacao))
                    {
                        <p class="mb-0">
                            @historico.Observacao
                        </p>
                    }

                </div>
            }

        </div>
    </div>

    <a asp-action="Index"
       asp-route-filialId="@Model.FilialId"
       class="btn btn-secondary mb-4">
        Voltar aos pedidos
    </a>

</div>
