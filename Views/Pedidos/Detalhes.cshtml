@model LojaCupCake.Models.Pedido

@{
    ViewData["Title"] = "Detalhes do pedido";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    var pagamento = Model.Pagamentos
        .OrderByDescending(p => p.CriadoEm)
        .ThenByDescending(p => p.PagamentoId)
        .FirstOrDefault();

    bool permiteSimular =
        Model.StatusPedido == LojaCupCake.Models.StatusPedido.AguardandoAprovacao &&
        pagamento != null &&
        pagamento.FormaPagamento != LojaCupCake.Models.FormaPagamento.Dinheiro &&
        (pagamento.StatusPagamento == LojaCupCake.Models.StatusPagamento.Pendente ||
         pagamento.StatusPagamento == LojaCupCake.Models.StatusPagamento.Recusado);


    // Etapas de acompanhamento do pedido
    var etapas = Model.TipoRecebimento ==
        LojaCupCake.Models.TipoRecebimento.Entrega

        ? new[]
        {
            (Status: LojaCupCake.Models.StatusPedido.AguardandoAprovacao, Nome: "Aguardando aprovação"),
            (Status: LojaCupCake.Models.StatusPedido.Aprovado, Nome: "Aprovado"),
            (Status: LojaCupCake.Models.StatusPedido.EmPreparacao, Nome: "Em preparação"),
            (Status: LojaCupCake.Models.StatusPedido.Pronto, Nome: "Pronto"),
            (Status: LojaCupCake.Models.StatusPedido.SaiuParaEntrega, Nome: "Saiu para entrega"),
            (Status: LojaCupCake.Models.StatusPedido.Concluido, Nome: "Concluído")
        }

        : new[]
        {
            (Status: LojaCupCake.Models.StatusPedido.AguardandoAprovacao, Nome: "Aguardando aprovação"),
            (Status: LojaCupCake.Models.StatusPedido.Aprovado, Nome: "Aprovado"),
            (Status: LojaCupCake.Models.StatusPedido.EmPreparacao, Nome: "Em preparação"),
            (Status: LojaCupCake.Models.StatusPedido.Pronto, Nome: "Pronto para retirada"),
            (Status: LojaCupCake.Models.StatusPedido.Concluido, Nome: "Concluído")
        };

    var etapaAtual = Array.FindIndex(
        etapas,
        e => e.Status == Model.StatusPedido
    );

    var progresso = etapaAtual <= 0
        ? 0
        : (int)Math.Round(
            (double)etapaAtual / (etapas.Length - 1) * 100
        );

    bool pedidoEncerrado =
        Model.StatusPedido == LojaCupCake.Models.StatusPedido.Cancelado ||
        Model.StatusPedido == LojaCupCake.Models.StatusPedido.Rejeitado;
}

<div class="container mt-4">

    <h2>Pedido @Model.CodigoPedido</h2>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Erro"]
        </div>
    }

    @if (pedidoEncerrado)
    {
        <div class="alert alert-danger mb-4">
            <h5 class="mb-1">
                Pedido @Model.StatusPedido
            </h5>
            <p class="mb-0">
                Este pedido não está mais em andamento.
            </p>
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-header">
                Acompanhamento do pedido
            </div>

            <div class="card-body">

                <div class="progress"
                     style="height: 10px;"
                     role="progressbar"
                     aria-valuenow="@progresso"
                     aria-valuemin="0"
                     aria-valuemax="100">

                    <div class="progress-bar"
                         style="width: @(progresso)%; background-color: #dc5b83;">
                    </div>

                </div>

                <div class="d-flex justify-content-between flex-wrap gap-3 mt-3">

                    @for (int i = 0; i < etapas.Length; i++)
                    {
                        bool concluida = i < etapaAtual;
                        bool atual = i == etapaAtual;

                        <div class="text-center flex-fill"
                             style="min-width: 90px;">

                            <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center fw-bold"
                                 style="
                                        width: 34px;
                                        height: 34px;
                                        background-color: @(concluida || atual ? "#dc5b83" : "#e9ecef");
                                        color: @(concluida || atual ? "white" : "#6c757d");
                                     ">

                                @(concluida ? "✓" : (i + 1).ToString())

                            </div>

                            <div class="small mt-2 @(atual ? "fw-bold text-dark" : "text-muted")">
                                @etapas[i].Nome
                            </div>

                        </div>
                    }

                </div>

                <hr />

                <p class="mb-0">
                    <strong>Status atual:</strong>
                    @Model.StatusPedido
                </p>

            </div>
        </div>
    }



    @if (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Concluido)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Avalie sua experiência!</h5>
            </div>

            <div class="card-body">

                <h6>Avaliação do atendimento</h6>

                @if (Model.AvaliacaoAtendimento == null)
                {
                    <form asp-action="AvaliarAtendimento" method="post">
                        <input type="hidden" name="pedidoId"
                               value="@Model.PedidoId" />

                        <label class="form-label">Sua nota</label>
                        <select name="nota" class="form-select mb-3" required>
                            <option value="">Selecione</option>
                            @for (int n = 5; n >= 1; n--)
                            {
                                <option value="@n">@n estrelas</option>
                            }
                        </select>

                        <label class="form-label">Comentário</label>
                        <textarea name="comentario"
                          class="form-control mb-3"
                          maxlength="500"
                          placeholder="Conte como foi sua experiência..."></textarea>

                        <button class="btn btn-primary" type="submit">
                            Enviar avaliação
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-success">
                        Atendimento avaliado:
                        <strong>@Model.AvaliacaoAtendimento.Nota/5 ⭐</strong>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(
                                Model.AvaliacaoAtendimento.Comentario))
                    {
                        <p>@Model.AvaliacaoAtendimento.Comentario</p>
                    }
                }

                <hr />

                <h6>Avaliação dos produtos</h6>

                @foreach (var item in Model.Itens
                            .GroupBy(i => i.ProdutoId)
                            .Select(g => g.First()))
                {
                    var avaliacao = Model.AvaliacoesProdutos
                    .FirstOrDefault(a => a.ProdutoId == item.ProdutoId);

                    <div class="border rounded p-3 mb-3">
                        <strong>@item.NomeProdutoSnapshot</strong>

                        @if (avaliacao == null)
                        {
                            <form asp-action="AvaliarProduto" method="post"
                                  class="mt-2">

                                <input type="hidden" name="pedidoId"
                                       value="@Model.PedidoId" />

                                <input type="hidden" name="produtoId"
                                       value="@item.ProdutoId" />

                                <label class="form-label">Sua nota</label>
                                <select name="nota" class="form-select mb-2"
                                        required>
                                    <option value="">Selecione</option>
                                    @for (int n = 5; n >= 1; n--)
                                    {
                                        <option value="@n">@n estrelas</option>
                                    }
                                </select>

                                <textarea name="comentario"
                              class="form-control mb-2"
                              maxlength="500"
                              placeholder="O que achou deste cupcake?"></textarea>

                                <button type="submit"
                                        class="btn btn-outline-primary btn-sm">
                                    Avaliar produto
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-success mb-0 mt-2">
                                Avaliado: <strong>@avaliacao.Nota/5 ⭐</strong>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(avaliacao.Comentario))
                            {
                                <p class="mb-0">@avaliacao.Comentario</p>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }


    
    @if (Model.StatusPedido ==
        LojaCupCake.Models.StatusPedido.AguardandoAprovacao ||
        Model.StatusPedido ==
        LojaCupCake.Models.StatusPedido.Aprovado ||
        Model.StatusPedido ==
        LojaCupCake.Models.StatusPedido.EmPreparacao ||
        Model.StatusPedido ==
        LojaCupCake.Models.StatusPedido.Pronto)
    {
        <div class="card border-danger mb-4">
            <div class="card-body">

                <h5>Cancelar pedido</h5>

                <p class="text-muted">
                    O cancelamento devolverá os produtos reservados ao estoque.
                    Essa operação não poderá ser desfeita.
                </p>

                <form asp-action="Cancelar"
                      method="post"
                      onsubmit="return confirm('Tem certeza que deseja cancelar este pedido?');">

                    <input type="hidden"
                           name="pedidoId"
                           value="@Model.PedidoId" />

                    <button type="submit"
                            class="btn btn-outline-danger">
                        Cancelar pedido
                    </button>

                </form>

            </div>
        </div>
    }




    <div class="card mb-4">
        <div class="card-header">Informações do pedido</div>

        <div class="card-body">
            <p><strong>Filial:</strong> @Model.Filial.Nome</p>

            <p>
                <strong>Data:</strong>
                @(Model.DataPedido.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
            </p>

            <p><strong>Status:</strong> @Model.StatusPedido</p>

            <p><strong>Recebimento:</strong> @Model.TipoRecebimento</p>

            @if (Model.TipoRecebimento == LojaCupCake.Models.TipoRecebimento.Retirada &&
                 !string.IsNullOrEmpty(Model.CodigoRetirada) &&
                 Model.StatusPedido == LojaCupCake.Models.StatusPedido.Pronto)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    <strong>Código de retirada:</strong>
                    <span class="fs-4 text-primary fw-bold ms-2">@Model.CodigoRetirada</span>
                    <div class="small mt-1">Apresente este código à loja. O pedido só será finalizado após a validação pela equipe.</div>
                </div>
            }

            @if (Model.TipoRecebimento == LojaCupCake.Models.TipoRecebimento.Entrega &&
                 (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Pronto ||
                  Model.StatusPedido == LojaCupCake.Models.StatusPedido.SaiuParaEntrega) &&
                 !(Model.EntregaConfirmadaPelaLoja && Model.EntregaConfirmadaPeloCliente))
            {
                <div class="alert alert-info mt-3 mb-0">
                    <strong>Confirmação de entrega pendente</strong>
                    <div class="small">Loja: @(Model.EntregaConfirmadaPelaLoja ? "confirmada" : "aguardando")</div>
                    <div class="small">Cliente: @(Model.EntregaConfirmadaPeloCliente ? "confirmada" : "aguardando")</div>
                    @if (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Pronto)
                    {
                        <div class="small mt-1">O pedido está pronto. Esta notificação permanecerá até que a loja e o cliente confirmem a entrega.</div>
                    }
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">Produtos</div>

        <div class="card-body">

            @foreach (var item in Model.Itens)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span>
                        @item.Quantidade x @item.NomeProdutoSnapshot
                    </span>

                    <strong>
                        @item.TotalItem.ToString("C", cultura)
                    </strong>
                </div>
            }

            <hr />

            <div class="d-flex justify-content-between">
                <span>Subtotal</span>
                <strong>@Model.Subtotal.ToString("C", cultura)</strong>
            </div>

            <div class="d-flex justify-content-between">
                <span>Taxa de entrega</span>
                <strong>@Model.TaxaEntrega.ToString("C", cultura)</strong>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <h5>Total</h5>
                <h5 class="text-primary">
                    @Model.Total.ToString("C", cultura)
                </h5>
            </div>
        </div>
    </div>


    @if (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Concluido)
    {
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">⭐ Avalie sua experiência!</h5>
            </div>

            <div class="card-body">

                <h6>Avaliação do atendimento</h6>

                @if (Model.AvaliacaoAtendimento == null)
                {
                    <form asp-action="AvaliarAtendimento" method="post">
                        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />

                        <label class="form-label">Sua nota</label>
                        <select name="nota" class="form-select mb-3" required>
                            <option value="">Selecione</option>
                            @for (int n = 5; n >= 1; n--)
                            {
                                <option value="@n">@n estrelas</option>
                            }
                        </select>

                        <label class="form-label">Comentário</label>
                        <textarea name="comentario"
                          class="form-control mb-3"
                          maxlength="500"
                          placeholder="Conte como foi sua experiência..."></textarea>

                        <button class="btn btn-primary" type="submit">
                            Enviar avaliação
                        </button>
                    </form>
                }
                else
                {
                    <p class="text-success">
                        Atendimento avaliado:
                        <strong>@Model.AvaliacaoAtendimento.Nota/5 ⭐</strong>
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.AvaliacaoAtendimento.Comentario))
                    {
                        <p>@Model.AvaliacaoAtendimento.Comentario</p>
                    }
                }

                <hr />

                <h6>Avaliação dos produtos</h6>

                @foreach (var item in Model.Itens
                            .GroupBy(i => i.ProdutoId)
                            .Select(g => g.First()))
                {
                    var avaliacao = Model.AvaliacoesProdutos
                    .FirstOrDefault(a => a.ProdutoId == item.ProdutoId);

                    <div class="border rounded p-3 mb-3">
                        <strong>@item.NomeProdutoSnapshot</strong>

                        @if (avaliacao == null)
                        {
                            <form asp-action="AvaliarProduto"
                                  method="post"
                                  class="mt-2">

                                <input type="hidden" name="pedidoId"
                                       value="@Model.PedidoId" />

                                <input type="hidden" name="produtoId"
                                       value="@item.ProdutoId" />

                                <label class="form-label">Sua nota</label>
                                <select name="nota" class="form-select mb-2" required>
                                    <option value="">Selecione</option>
                                    @for (int n = 5; n >= 1; n--)
                                    {
                                        <option value="@n">@n estrelas</option>
                                    }
                                </select>

                                <textarea name="comentario"
                              class="form-control mb-2"
                              maxlength="500"
                              placeholder="O que achou deste cupcake?"></textarea>

                                <button type="submit"
                                        class="btn btn-outline-primary btn-sm">
                                    Avaliar produto
                                </button>
                            </form>
                        }
                        else
                        {
                            <p class="text-success mb-0 mt-2">
                                Avaliado:
                                <strong>@avaliacao.Nota/5 ⭐</strong>
                            </p>

                            @if (!string.IsNullOrWhiteSpace(avaliacao.Comentario))
                            {
                                <p class="mb-0">@avaliacao.Comentario</p>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }




    @if (Model.EnderecoEntrega != null)
    {
        <div class="card mb-4">
            <div class="card-header">Endereço de entrega</div>

            <div class="card-body">
                <p>@Model.EnderecoEntrega.Destinatario</p>
                <p>
                    @Model.EnderecoEntrega.Logradouro,
                    @Model.EnderecoEntrega.Numero
                </p>
                <p>
                    @Model.EnderecoEntrega.Bairro -
                    @Model.EnderecoEntrega.Cidade /
                    @Model.EnderecoEntrega.Uf
                </p>
                <p>CEP: @Model.EnderecoEntrega.Cep</p>
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">Pagamento</div>

        <div class="card-body">

            @if (pagamento != null)
            {
                <p><strong>Forma:</strong> @pagamento.FormaPagamento</p>

                <p>
                    <strong>Status:</strong>
                    @pagamento.StatusPagamento
                </p>

                <p>
                    <strong>Valor:</strong>
                    @pagamento.Valor.ToString("C", cultura)
                </p>

                @if (Model.StatusPedido == LojaCupCake.Models.StatusPedido.AguardandoAprovacao &&
                     pagamento.StatusPagamento == LojaCupCake.Models.StatusPagamento.Recusado)
                {
                    <div class="alert alert-warning mt-3">
                        O pagamento foi recusado. Você pode escolher outra forma de pagamento para gerar uma nova tentativa.
                    </div>
                    <form asp-action="TrocarFormaPagamento" method="post" class="row g-2 align-items-end">
                        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                        <div class="col-md-6">
                            <label for="novaFormaPagamento" class="form-label">Nova forma de pagamento</label>
                            <select id="novaFormaPagamento" name="novaFormaPagamento" class="form-select" required>
                                @foreach (var forma in Enum.GetValues<LojaCupCake.Models.FormaPagamento>().Where(f => f != pagamento.FormaPagamento))
                                {
                                    <option value="@((int)forma)">@forma</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-auto">
                            <button type="submit" class="btn btn-warning">Alterar forma de pagamento</button>
                        </div>
                    </form>
                }

                @if (permiteSimular)
                {
                    <div class="alert alert-info">
                        Simulação acadêmica: nenhuma cobrança real será realizada.
                        Escolha o resultado que deseja simular.
                    </div>

                    <div class="d-flex gap-2 flex-wrap">

                        <form asp-action="SimularPagamento" method="post">
                            <input type="hidden"
                                   name="pedidoId"
                                   value="@Model.PedidoId" />

                            <input type="hidden"
                                   name="aprovado"
                                   value="true" />

                            <button type="submit"
                                    class="btn btn-success">
                                Simular aprovação
                            </button>
                        </form>

                        <form asp-action="SimularPagamento" method="post">
                            <input type="hidden"
                                   name="pedidoId"
                                   value="@Model.PedidoId" />

                            <input type="hidden"
                                   name="aprovado"
                                   value="false" />

                            <button type="submit"
                                    class="btn btn-outline-danger">
                                Simular recusa
                            </button>
                        </form>

                    </div>
                }
                else if (pagamento.FormaPagamento ==
                LojaCupCake.Models.FormaPagamento.Dinheiro &&
                pagamento.StatusPagamento ==
                LojaCupCake.Models.StatusPagamento.Pendente)
                {
                    <div class="alert alert-info mb-0">
                        O pagamento será confirmado no recebimento do pedido.
                    </div>
                }

                @if (Model.Pagamentos.Count > 1)
                {
                    <hr />
                    <h6>Histórico de tentativas</h6>
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead>
                                <tr><th>Data</th><th>Forma</th><th>Status</th><th class="text-end">Valor</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var tentativa in Model.Pagamentos.OrderBy(p => p.CriadoEm).ThenBy(p => p.PagamentoId))
                                {
                                    <tr>
                                        <td>@tentativa.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@tentativa.FormaPagamento</td>
                                        <td>@tentativa.StatusPagamento</td>
                                        <td class="text-end">@tentativa.Valor.ToString("C", cultura)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }

        </div>
    </div>

    @if (Model.TipoRecebimento == LojaCupCake.Models.TipoRecebimento.Entrega &&
         (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Pronto ||
          Model.StatusPedido == LojaCupCake.Models.StatusPedido.SaiuParaEntrega) &&
         !(Model.EntregaConfirmadaPelaLoja && Model.EntregaConfirmadaPeloCliente))
    {
        <div class="card mb-4 border-primary">
            <div class="card-body">
                <h5>Confirmação de entrega</h5>
                <p class="mb-1">Loja: <strong>@(Model.EntregaConfirmadaPelaLoja ? "Confirmada" : "Pendente")</strong></p>
                <p class="mb-3">Cliente: <strong>@(Model.EntregaConfirmadaPeloCliente ? "Confirmada" : "Pendente")</strong></p>

                @if (Model.StatusPedido == LojaCupCake.Models.StatusPedido.Pronto)
                {
                    <div class="alert alert-warning mb-0">
                        Seu pedido está pronto para entrega. A opção de confirmar o recebimento ficará disponível quando a loja registrar a saída para entrega.
                        Esta notificação continuará aparecendo até que a loja e o cliente confirmem.
                    </div>
                }
                else if (!Model.EntregaConfirmadaPeloCliente)
                {
                    <p class="text-muted">Confirme somente depois de receber o pedido. A conclusão ocorrerá quando a loja e você confirmarem a entrega.</p>
                    <form asp-action="ConfirmarEntrega" method="post">
                        <input type="hidden" name="pedidoId" value="@Model.PedidoId" />
                        <button type="submit" class="btn btn-primary">Confirmar que recebi o pedido</button>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-0">Você já confirmou o recebimento. Aguardando confirmação da loja.</div>
                }
            </div>
        </div>
    }

    <div class="card mb-4">
        <div class="card-header">Histórico do pedido</div>

        <div class="card-body">
            @foreach (var historico in Model.Historico.OrderBy(h => h.DataAlteracao))
            {
                <div class="border-bottom py-2">
                    <strong>@historico.StatusNovo</strong>

                    <br />

                    <small class="text-muted">
                        @(historico.DataAlteracao.ToLocalTime()
                                            .ToString("dd/MM/yyyy HH:mm"))
                    — @(historico.Responsavel?.Email ?? "Sistema")
                </small>

                @if (!string.IsNullOrWhiteSpace(historico.Observacao))
                    {
                        <p class="mb-0">@historico.Observacao</p>
                    }
                </div>
            }
        </div>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar aos meus pedidos
    </a>

</div>
