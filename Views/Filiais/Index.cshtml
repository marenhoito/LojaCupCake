@model IEnumerable<LojaCupCake.Models.Filial>

@{
    ViewData["Title"] = "Gerenciar Filiais";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Filiais</h2>

        <a asp-action="Create" class="btn btn-primary">
            Nova filial
        </a>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success">
            @TempData["Sucesso"]
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th>Cidade</th>
                    <th>Telefone</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var filial in Model)
                {
                    <tr>
                        <td>@filial.Codigo</td>
                        <td>@filial.Nome</td>
                        <td>@filial.Cidade / @filial.Uf</td>
                        <td>@filial.Telefone</td>

                        <td>
                            @if (filial.Ativo)
                            {
                                <span class="badge bg-success">
                                    Ativa
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inativa
                                </span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@filial.FilialId"
                               class="btn btn-sm btn-primary">
                                Editar
                            </a>

                            <form asp-action="AlterarStatus"
                                  asp-route-id="@filial.FilialId"
                                  method="post"
                                  class="d-inline">

                                <button type="submit"
                                        class="btn btn-sm @(filial.Ativo ? "btn-danger" : "btn-success")">

                                    @(filial.Ativo ? "Desativar" : "Ativar")

                                </button>

                        
                            </form>

                            <a asp-controller="Funcionamento"
                               asp-action="Index"
                               asp-route-filialId="@filial.FilialId"
                               class="btn btn-sm btn-info">
                                Horários
                            </a>


                        </td>



                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            Nenhuma filial cadastrada.
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>

</div>
