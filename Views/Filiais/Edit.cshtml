@model LojaCupCake.ViewModels.FilialViewModel

@{
    ViewData["Title"] = "Editar Filial";
}

<div class="container mt-4">

    <h2>Editar filial</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="FilialId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Codigo"></label>
            <input asp-for="Codigo" class="form-control" />
            <span asp-validation-for="Codigo"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Nome"></label>
            <input asp-for="Nome" class="form-control" />
            <span asp-validation-for="Nome"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Telefone"></label>
            <input asp-for="Telefone" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email"
                  class="text-danger"></span>
        </div>

        <hr />
        <h5>Endereço</h5>

        <div class="mb-3">
            <label asp-for="Cep"></label>
            <input asp-for="Cep" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Logradouro"></label>
            <input asp-for="Logradouro" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Numero"></label>
            <input asp-for="Numero" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Complemento"></label>
            <input asp-for="Complemento" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Bairro"></label>
            <input asp-for="Bairro" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Cidade"></label>
            <input asp-for="Cidade" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Uf"></label>
            <input asp-for="Uf"
                   class="form-control"
                   maxlength="2" />
        </div>

        <button type="submit" class="btn btn-success">
            Salvar alterações
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Voltar
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
