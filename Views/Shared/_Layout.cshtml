@{
    var controllerAtual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var actionAtual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    bool usuarioAutenticado = User.Identity?.IsAuthenticated == true;
}

@functions {
    public bool NavAtivo(string controller, string? action = null)
    {
        var atualController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var atualAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        return string.Equals(atualController, controller, StringComparison.OrdinalIgnoreCase)
            && (action == null || string.Equals(atualAction, action, StringComparison.OrdinalIgnoreCase));
    }
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff8f5" />
    <title>@ViewData["Title"] - LojaCupCake</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LojaCupCake.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-xl cupcake-navbar">
            <div class="container-fluid nav-shell">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index" aria-label="LojaCupCake - Início">
                    <span class="brand-mark">LC</span>
                    <span class="brand-name">Loja<span>CupCake</span><small>um carinho em cada mordida</small></span>
                </a>

                <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Abrir menu">
                    <span></span><span></span><span></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav main-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(NavAtivo("Home") ? "active" : "")" asp-controller="Home" asp-action="Index" aria-current="@(NavAtivo("Home") ? "page" : null)">Início</a></li>
                        <li class="nav-item"><a class="nav-link @(NavAtivo("Catalogo") ? "active" : "")" asp-controller="Catalogo" asp-action="Index" aria-current="@(NavAtivo("Catalogo") ? "page" : null)">Cardápio</a></li>
                        <li class="nav-item"><a class="nav-link @(NavAtivo("Carrinho") ? "active" : "")" asp-controller="Carrinho" asp-action="Index" aria-current="@(NavAtivo("Carrinho") ? "page" : null)">Carrinho</a></li>

                        @if (User.IsInRole("Cliente"))
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Pedidos") ? "active" : "")" asp-controller="Pedidos" asp-action="Index">Meus pedidos</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Enderecos") ? "active" : "")" asp-controller="Enderecos" asp-action="Index">Endereços</a></li>
                        }

                        @if (User.IsInRole("Funcionario"))
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("AreaFuncionario") ? "active" : "")" asp-controller="AreaFuncionario" asp-action="Index">Minha área</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Estoque") ? "active" : "")" asp-controller="Estoque" asp-action="Index">Estoque</a></li>
                        }

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Filiais") ? "active" : "")" asp-controller="Filiais" asp-action="Index">Filiais</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Categorias") ? "active" : "")" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Produtos") ? "active" : "")" asp-controller="Produtos" asp-action="Index">Produtos</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Funcionarios") ? "active" : "")" asp-controller="Funcionarios" asp-action="Index">Funcionários</a></li>
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Estoque") ? "active" : "")" asp-controller="Estoque" asp-action="Index">Estoque</a></li>
                        }

                        @if (User.IsInRole("Administrador") || User.IsInRole("Funcionario"))
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("FuncionamentoLoja") || NavAtivo("Funcionamento") ? "active" : "")" asp-controller="FuncionamentoLoja" asp-action="Index">Funcionamento</a></li>
                        }

                        @if (usuarioAutenticado)
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Chat") ? "active" : "")" asp-controller="Chat" asp-action="Index">Mensagens</a></li>
                        }

                        @await Component.InvokeAsync("GestaoPedidosMenu")

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item"><a class="nav-link @(NavAtivo("Dashboard") ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        }
                    </ul>

                    <div class="nav-account">
                        @if (usuarioAutenticado)
                        {
                            <span class="nav-greeting">Olá, <strong>@User.Identity?.Name</strong></span>
                            <form asp-area="" asp-controller="Conta" asp-action="Logout" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="nav-logout">Sair</button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="" asp-controller="Conta" asp-action="Login" class="nav-login">Entrar</a>
                            <a asp-area="" asp-controller="Conta" asp-action="Cadastro" class="nav-register">Criar conta</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (usuarioAutenticado)
    {
        <div id="pedidoNotificacoes"
             style="position:fixed;
                    top:90px;
                    right:16px;
                    z-index:1080;
                    width:min(420px, calc(100vw - 32px));"
             aria-live="polite"
             aria-atomic="false">
        </div>
    }

    <main class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">LC</span><span>LojaCupCake</span></a>
            <p>Feito com carinho para adoçar seus melhores momentos.</p>
            <span>© @DateTime.Now.Year LojaCupCake · <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidade</a></span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/signalr/signalr.min.js"></script>

    @if (usuarioAutenticado)
    {
        <script>
            (() => {
                const container =
                    document.getElementById("pedidoNotificacoes");

                const usuarioId =
                    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                                ));

            const chatUrl =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                        Url.Action("Pedido", "Chat")
                                ));

            if (!container || typeof signalR === "undefined")
                return;

            function mostrarNotificacao(titulo, mensagem, url, textoLink) {
                const card = document.createElement("div");
                card.className = "alert alert-info shadow-sm mb-2";
                card.setAttribute("role", "status");

                const fechar = document.createElement("button");
                fechar.type = "button";
                fechar.className = "btn-close float-end";
                fechar.setAttribute("aria-label", "Fechar");
                fechar.addEventListener("click", () => card.remove());

                const cabecalho = document.createElement("div");
                cabecalho.className = "fw-bold mb-1";
                cabecalho.textContent = titulo;

                const corpo = document.createElement("p");
                corpo.className = "mb-2";
                corpo.textContent = mensagem;

                card.append(fechar, cabecalho, corpo);

                if (url) {
                    const link = document.createElement("a");
                    link.className = "alert-link";
                    link.href = url;
                    link.textContent = textoLink;
                    card.appendChild(link);
                }

                container.prepend(card);

                while (container.children.length > 3) {
                    container.lastElementChild.remove();
                }
            }

            const conexao = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/chat-pedido")
                .withAutomaticReconnect()
                .build();

            // NOTIFICAÇÃO DE NOVA MENSAGEM
            conexao.on("NovaMensagem", mensagem => {

                if (!mensagem) return;

                // Não notificar o próprio remetente.
                if (mensagem.remetenteUsuarioId === usuarioId)
                    return;

                const conteudo = mensagem.conteudo || "";

                const resumo = conteudo.length > 160
                    ? conteudo.substring(0, 160) + "..."
                    : conteudo;

                mostrarNotificacao(
                    "Nova mensagem de " +
                        (mensagem.remetenteNome || "Atendimento"),
                    resumo,
                    chatUrl + "?id=" +
                        encodeURIComponent(mensagem.pedidoId),
                    "Abrir conversa"
                );
            });

            // NOTIFICAÇÃO DE ATUALIZAÇÃO DO PEDIDO
            conexao.on("StatusPedidoAtualizado", aviso => {

                if (!aviso) return;

                mostrarNotificacao(
                    "Atualização do pedido " + aviso.codigoPedido,
                    aviso.mensagem,
                    aviso.url,
                    "Acompanhar pedido"
                );
            });

            conexao.start().catch(erro => {
                console.warn(
                    "Não foi possível conectar às notificações.",
                    erro
                );
            });
        })();
    </script>
        }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>