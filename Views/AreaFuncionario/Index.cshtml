@model LojaCupCake.ViewModels.PainelFuncionarioViewModel

@{
    ViewData["Title"] = "Área do Funcionário";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Área do Funcionário</h2>
        <p class="text-muted">
            Bem-vindo(a), @Model.NomeCompleto!
        </p>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pedidos aprovados por você</h6>
                    <h2 class="fw-bold text-primary">
                        @Model.PedidosAprovados
                    </h2>
                    <small class="text-muted">
                        Total de pedidos aprovados.
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Tempo de cadastro</h6>
                    <h2 class="fw-bold text-primary">
                        @Model.DiasCadastrado dias
                    </h2>
                    <small class="text-muted">
                        Tempo desde seu cadastro na loja.
                    </small>
                </div>
            </div>
        </div>

    </div>

    <div class="card mb-4">
        <div class="card-header">
            Minhas filiais
        </div>

        <div class="card-body">

            @if (!Model.Filiais.Any())
            {
                <div class="alert alert-warning mb-0">
                    Você não possui vínculos ativos com filiais.
                    Entre em contato com o administrador.
                </div>
            }
            else
            {
                <div class="row">

                    @foreach (var filial in Model.Filiais)
                    {
                        <div class="col-md-6 col-lg-4 mb-3">
                            <div class="card h-100">
                                <div class="card-body">

                                    <h5 class="card-title">
                                        @filial.NomeFilial
                                    </h5>

                                    <p class="text-muted">
                                        Filial vinculada
                                    </p>

                                    <hr />

                                    <h6>Minhas permissões</h6>

                                    <ul class="list-unstyled">

                                        <li>
                                            @(filial.PodeAprovarPedidos
                                                                                ? "✓ Aprovar pedidos"
                                                                                : "✕ Aprovar pedidos")
                                                                                                  </li>

                                        <li>
                                            @(filial.PodeCadastrarFuncionarios
                                                                                ? "✓ Cadastrar funcionários"
                                                                                : "✕ Cadastrar funcionários")
                                </li>

                                    </ul>

                                    <a asp-controller="GestaoPedidos"
                                       asp-action="Index"
                                       asp-route-filialId="@filial.FilialId"
                                       class="btn btn-primary w-100">
                                        Acessar filial
                                    </a>

                            @if (filial.PodeCadastrarFuncionarios)
                                    {
                                        <a asp-controller="Funcionarios"
                                           asp-action="Create"
                                           asp-route-filialId="@filial.FilialId"
                                           class="btn btn-outline-success w-100 mt-2">
                                            Cadastrar funcionário
                                        </a>
                                    }


                                </div>
                            </div>
                        </div>
                                }

                </div>
            }

        </div>
    </div>

    ff
        
    

</div>
