@model LojaCupCake.ViewModels.CadastroClienteViewModel

@{
    ViewData["Title"] = "Criar conta";
}

<div class="register-page">
    <section class="register-card">
        <aside class="register-story">
            <div class="register-story-brand">
                <span class="register-brand-mark">LC</span>
                <span>LojaCupCake</span>
            </div>

            <span class="register-story-kicker">UM CARINHO EM CADA MORDIDA</span>
            <h1>Um novo carinho começa <em>aqui.</em></h1>
            <p>Crie sua conta para descobrir sabores, fazer seus pedidos e acompanhar cada etapa da sua experiência com a LojaCupCake.</p>

            <div class="register-story-art" aria-hidden="true">
                <span class="register-art-ring"></span>
                <span class="register-art-cupcake">🧁</span>
                <span class="register-art-spark register-spark-one">✦</span>
                <span class="register-art-spark register-spark-two">✧</span>
            </div>

            <small>Feito com carinho para adoçar seus melhores momentos.</small>
        </aside>

        <div class="register-form-panel">
            <div class="register-form-heading">
                <span class="register-form-kicker">SUA CONTA</span>
                <h2>Crie sua conta</h2>
                <p>Preencha seus dados para começar.</p>
            </div>

            <form asp-action="Cadastro" method="post" class="register-form">
                <div asp-validation-summary="ModelOnly" class="text-danger register-validation-summary"></div>

                <div class="register-fields-grid">
                    <div class="register-field register-field-wide">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control" autocomplete="name" placeholder="Seu nome completo" />
                        <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="Cpf" class="form-label"></label>
                        <input asp-for="Cpf" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Cpf" class="text-danger"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" type="tel" autocomplete="tel" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>

                    <div class="register-field register-field-wide">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" autocomplete="email" placeholder="seuemail@exemplo.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="Senha" class="form-label"></label>
                        <input asp-for="Senha" class="form-control" type="password" autocomplete="new-password" placeholder="Crie uma senha" />
                        <span asp-validation-for="Senha" class="text-danger"></span>
                    </div>

                    <div class="register-field">
                        <label asp-for="ConfirmarSenha" class="form-label"></label>
                        <input asp-for="ConfirmarSenha" class="form-control" type="password" autocomplete="new-password" placeholder="Repita a senha" />
                        <span asp-validation-for="ConfirmarSenha" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-cupcake-primary register-submit">Criar conta</button>
            </form>

            <p class="register-login-link">
                Já tem uma conta?
                <a asp-controller="Conta" asp-action="Login">Entrar</a>
            </p>
        </div>
    </section>
</div>

<style>
    .register-page {
        width: 100%;
        max-width: 1080px;
        margin: 48px auto 70px;
        padding: 0 24px;
    }

    .register-card {
        display: grid;
        grid-template-columns: .92fr 1.08fr;
        min-height: 650px;
        overflow: hidden;
        border: 1px solid #efdde3;
        border-radius: 25px;
        background: #fff;
        box-shadow: 0 18px 50px rgba(89, 52, 69, .10);
    }

    .register-story {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 0;
        padding: 42px 43px 30px;
        overflow: hidden;
        background: linear-gradient(145deg, #fff0f2 0%, #fff5ec 58%, #f8e8ef 100%);
    }

        .register-story::before,
        .register-story::after {
            position: absolute;
            border: 1px solid rgba(205, 126, 153, .18);
            border-radius: 50%;
            content: "";
            pointer-events: none;
        }

        .register-story::before {
            width: 360px;
            height: 360px;
            top: 220px;
            left: -140px;
        }

        .register-story::after {
            width: 260px;
            height: 260px;
            top: 270px;
            left: -90px;
        }

    .register-story-brand {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: #563b48;
        font-size: 15px;
        font-weight: 850;
    }

    .register-brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 13px;
        color: #fff;
        background: linear-gradient(140deg, #e98aa6, #c94e78);
        box-shadow: 0 7px 16px rgba(201, 78, 120, .2);
        font-size: 12px;
    }

    .register-story-kicker {
        position: relative;
        z-index: 1;
        margin-top: 54px;
        color: #a65a77;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.8px;
    }

    .register-story h1 {
        position: relative;
        z-index: 1;
        max-width: 340px;
        margin: 13px 0 12px;
        color: #49323e;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(31px, 3.2vw, 43px);
        font-weight: 500;
        line-height: 1.12;
    }

        .register-story h1 em {
            color: #bd456e;
            font-weight: 500;
        }

    .register-story > p {
        position: relative;
        z-index: 1;
        max-width: 330px;
        margin: 0;
        color: #806a75;
        font-size: 12px;
        line-height: 1.8;
    }

    .register-story-art {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 190px;
        margin-top: auto;
    }

    .register-art-ring {
        position: absolute;
        width: 178px;
        height: 178px;
        border: 1px solid rgba(191, 112, 142, .22);
        border-radius: 50%;
        background: radial-gradient(circle at 35% 30%, rgba(255,255,255,.9), rgba(244,211,221,.55));
        box-shadow: 0 16px 34px rgba(163, 93, 119, .10);
    }

    .register-art-cupcake {
        position: relative;
        z-index: 1;
        font-size: 104px;
        filter: drop-shadow(0 13px 12px rgba(112, 63, 81, .15));
        transform: rotate(-7deg);
    }

    .register-art-spark {
        position: absolute;
        z-index: 2;
        color: #d36a91;
        font-size: 29px;
    }

    .register-spark-one {
        top: 9px;
        right: 22%;
    }

    .register-spark-two {
        bottom: 18px;
        left: 18%;
        color: #c49b6e;
        font-size: 38px;
    }

    .register-story > small {
        position: relative;
        z-index: 1;
        color: #987f89;
        font-size: 9px;
    }

    .register-form-panel {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
        padding: 42px clamp(28px, 4vw, 54px);
    }

    .register-form-heading {
        margin-bottom: 24px;
    }

    .register-form-kicker {
        color: #bd456e;
        font-size: 9px;
        font-weight: 850;
        letter-spacing: 1.8px;
    }

    .register-form-heading h2 {
        margin: 9px 0 7px;
        color: #49323e;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 32px;
        font-weight: 500;
    }

    .register-form-heading p {
        margin: 0;
        color: #8b7880;
        font-size: 12px;
    }

    .register-form {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .register-fields-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px 13px;
    }

    .register-field {
        min-width: 0;
    }

    .register-field-wide {
        grid-column: 1 / -1;
    }

    .register-field .form-label {
        display: block;
        margin-bottom: 6px;
        color: #644653;
        font-size: 11px;
        font-weight: 750;
    }

    .register-field .form-control {
        min-height: 44px;
        padding: 10px 12px;
        border: 1px solid #eadde2;
        border-radius: 11px;
        color: #49323e;
        background: #fffdfc;
        font-size: 12px;
    }

        .register-field .form-control:focus {
            border-color: #d88ca4;
            box-shadow: 0 0 0 .2rem rgba(217, 91, 131, .13);
        }

    .register-field .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 10px;
    }

    .register-submit {
        width: 100%;
        min-height: 48px;
        margin-top: 2px;
        border-radius: 12px;
    }

    .register-login-link {
        margin: 22px 0 0;
        color: #8b7880;
        text-align: center;
        font-size: 11px;
    }

        .register-login-link a {
            color: #bd456e;
            font-weight: 800;
        }

    .register-validation-summary:empty {
        display: none;
    }

    .register-validation-summary {
        margin-bottom: 2px;
        font-size: 11px;
    }

    @@media (max-width: 767.98px) {
        .register-page {
            margin: 24px auto 45px;
            padding: 0 14px;
        }

        .register-card {
            grid-template-columns: 1fr;
            min-height: 0;
            border-radius: 20px;
        }

        .register-story {
            min-height: 280px;
            padding: 27px 25px 20px;
        }

        .register-story-kicker {
            margin-top: 28px;
        }

        .register-story h1 {
            max-width: 420px;
            font-size: 32px;
        }

        .register-story-art {
            position: absolute;
            right: 7px;
            bottom: 0;
            width: 150px;
            min-height: 145px;
            margin: 0;
            opacity: .72;
        }

        .register-art-ring {
            width: 120px;
            height: 120px;
        }

        .register-art-cupcake {
            font-size: 72px;
        }

        .register-story > small {
            max-width: 210px;
        }

        .register-form-panel {
            padding: 34px 25px 31px;
        }

        .register-form-heading h2 {
            font-size: 28px;
        }
    }

    @@media (max-width: 480px) {
        .register-fields-grid {
            grid-template-columns: 1fr;
        }

        .register-field-wide {
            grid-column: auto;
        }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}