@model LojaCupCake.Models.Pedido

@{
    ViewData["Title"] = "Pedido confirmado";

    var cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");

    var pagamento = Model.Pagamentos
        .OrderByDescending(p => p.CriadoEm)
        .FirstOrDefault();
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-body text-center p-5">

            <div class="mb-3">
                <span class="text-success fs-1">✓</span>
            </div>

            <h2>Pedido recebido com sucesso!</h2>

            <p class="text-muted">
                Seu pedido foi registrado e aguarda aprovação da filial.
            </p>

            <hr />

            <h5>Código do pedido</h5>

            <h3 class="text-primary">
                @Model.CodigoPedido
            </h3>

            <div class="row text-start mt-4">

                <div class="col-md-6 mb-3">
                    <strong>Filial:</strong>
                    <p>@Model.Filial.Nome</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Data:</strong>
                    <p>
                        @(Model.DataPedido.ToLocalTime()
                                                .ToString("dd/MM/yyyy HH:mm"))
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Recebimento:</strong>
                    <p>
                        @(Model.TipoRecebimento == LojaCupCake.Models.TipoRecebimento.Entrega
                                                ? "Entrega"
                                                : "Retirada na loja")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Status:</strong>
                    <p>
                        <span class="badge bg-warning text-dark">
                            Aguardando aprovação
                        </span>
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.CodigoRetirada))
                {
                    <div class="col-12 mb-3">
                        <strong>Código de retirada:</strong>

                        <h4 class="text-primary">
                            @Model.CodigoRetirada
                        </h4>

                        <p class="text-muted">
                            Apresente este código na filial para retirar o pedido.
                        </p>
                    </div>
                }

                @if (Model.EnderecoEntrega != null)
                {
                    <div class="col-12 mb-3">
                        <strong>Endereço de entrega:</strong>

                        <p>
                            @Model.EnderecoEntrega.Logradouro,
                            @Model.EnderecoEntrega.Numero
                            - @Model.EnderecoEntrega.Bairro
                            <br />
                            @Model.EnderecoEntrega.Cidade
                            / @Model.EnderecoEntrega.Uf
                            <br />
                            CEP: @Model.EnderecoEntrega.Cep
                        </p>
                    </div>
                }

            </div>

            <hr />

            <div class="text-start">

                <h5>Produtos</h5>

                @foreach (var item in Model.Itens)
                {
                    <div class="d-flex justify-content-between mb-2">
                        <span>
                            @item.Quantidade x @item.NomeProdutoSnapshot
                        </span>

                        <strong>
                            @item.TotalItem.ToString("C", cultura)
                        </strong>
                    </div>
                }

                <hr />

                <div class="d-flex justify-content-between">
                    <span>Subtotal</span>
                    <strong>@Model.Subtotal.ToString("C", cultura)</strong>
                </div>

                <div class="d-flex justify-content-between">
                    <span>Taxa de entrega</span>
                    <strong>@Model.TaxaEntrega.ToString("C", cultura)</strong>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <h5>Total</h5>

                    <h5 class="text-primary">
                        @Model.Total.ToString("C", cultura)
                    </h5>
                </div>

                @if (pagamento != null)
                {
                    <p class="text-muted mt-3">
                        Pagamento: @pagamento.FormaPagamento
                        — @pagamento.StatusPagamento
                    </p>
                }

            </div>

            <hr />

            <a asp-controller="Catalogo"
               asp-action="Index"
               class="btn btn-primary mt-3">
                Voltar ao catálogo
            </a>

            <a asp-controller="Pedidos"
               asp-action="Index"
               class="btn btn-outline-primary mt-3">
                Meus pedidos
            </a>


        </div>
    </div>

</div>
